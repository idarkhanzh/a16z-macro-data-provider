# Copy to .env for local runs. On Railway, set these as service variables instead.

# From @BotFather
TELEGRAM_BOT_TOKEN=123456789:replace-with-your-bot-token

# One or more chat IDs, comma-separated: private chats, groups, or channels (-100...)
TELEGRAM_CHAT_IDS=123456789,-1001234567890

# BLS Public Data API v2 key: https://data.bls.gov/registrationEngine/
BLS_API_KEY=replace-with-your-bls-key

# Optional: DEBUG logs every poll
# LOG_LEVEL=INFO
